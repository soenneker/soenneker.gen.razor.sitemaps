<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="RazorSitemapGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Gen.Razor.Sitemaps targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host, never the application RuntimeIdentifier (for example browser-wasm). -->
        <RazorSitemapToolRuntimeIdentifier Condition="'$(RazorSitemapToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RazorSitemapToolRuntimeIdentifier>
        <_RazorSitemapExecutableName>Soenneker.Gen.Razor.Sitemaps.BuildTasks</_RazorSitemapExecutableName>
        <_RazorSitemapExecutableName Condition="$([System.String]::Copy('$(RazorSitemapToolRuntimeIdentifier)').StartsWith('win-'))">$(_RazorSitemapExecutableName).exe</_RazorSitemapExecutableName>
        <_RazorSitemapNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(RazorSitemapToolRuntimeIdentifier)/$(_RazorSitemapExecutableName)'))</_RazorSitemapNativePackagePath>
        <_RazorSitemapNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(RazorSitemapToolRuntimeIdentifier)/$(_RazorSitemapExecutableName)'))</_RazorSitemapNativeProjectPath>
        <RazorSitemapBuildTasksExecutablePath Condition="'$(RazorSitemapBuildTasksExecutablePath)' == '' and Exists('$(_RazorSitemapNativePackagePath)')">$(_RazorSitemapNativePackagePath)</RazorSitemapBuildTasksExecutablePath>
        <RazorSitemapBuildTasksExecutablePath Condition="'$(RazorSitemapBuildTasksExecutablePath)' == ''">$(_RazorSitemapNativeProjectPath)</RazorSitemapBuildTasksExecutablePath>
        <RazorSitemapEnabled Condition="'$(RazorSitemapEnabled)'==''">false</RazorSitemapEnabled>
        <RazorSitemapOutputPath Condition="'$(RazorSitemapOutputPath)'==''">wwwroot/sitemap.xml</RazorSitemapOutputPath>
        <RazorSitemapIncludeUnannotatedPages Condition="'$(RazorSitemapIncludeUnannotatedPages)'==''">true</RazorSitemapIncludeUnannotatedPages>
        <_RazorSitemapProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_RazorSitemapProjectDir>
        <_RazorSitemapProjectDir Condition="'$(_RazorSitemapProjectDir)' == ''">$(MSBuildProjectDirectory)</_RazorSitemapProjectDir>
        <_RazorSitemapBaseUrlArg Condition="'$(RazorSitemapBaseUrl)' != ''"> --baseUrl &quot;$(RazorSitemapBaseUrl)&quot;</_RazorSitemapBaseUrlArg>
        <_RazorSitemapOutputPathArg Condition="'$(RazorSitemapOutputPath)' != ''"> --outputPath &quot;$(RazorSitemapOutputPath)&quot;</_RazorSitemapOutputPathArg>
        <_RazorSitemapDefaultChangeFrequencyArg Condition="'$(RazorSitemapDefaultChangeFrequency)' != ''"> --defaultChangeFrequency &quot;$(RazorSitemapDefaultChangeFrequency)&quot;</_RazorSitemapDefaultChangeFrequencyArg>
        <_RazorSitemapDefaultPriorityArg Condition="'$(RazorSitemapDefaultPriority)' != ''"> --defaultPriority &quot;$(RazorSitemapDefaultPriority)&quot;</_RazorSitemapDefaultPriorityArg>
        <_RazorSitemapIncludeUnannotatedPagesArg> --includeUnannotatedPages &quot;$(RazorSitemapIncludeUnannotatedPages)&quot;</_RazorSitemapIncludeUnannotatedPagesArg>
    </PropertyGroup>

    <ItemGroup>
        <_RazorSitemapGeneratorInputs Include="$(_RazorSitemapProjectDir)\**\*.razor"
                                      Exclude="$(_RazorSitemapProjectDir)\bin\**;$(_RazorSitemapProjectDir)\obj\**" />
    </ItemGroup>

    <Target Name="RunRazorSitemapGeneratorBuildTasks"
            AfterTargets="Build"
            Inputs="@(_RazorSitemapGeneratorInputs);$(TargetPath);$(MSBuildProjectFullPath);$(RazorSitemapBuildTasksExecutablePath)"
            Outputs="$(RazorSitemapOutputPath)"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(RazorSitemapEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Gen.Razor.Sitemaps BuildTasks: projectDir=$(_RazorSitemapProjectDir) output=$(RazorSitemapOutputPath)" />
        <Error Condition="'$(_RazorSitemapProjectDir)' == ''"
               Text="Soenneker.Gen.Razor.Sitemaps: project directory could not be resolved." />
        <Error Condition="'$(RazorSitemapBuildTasksExecutablePath)'==''"
               Text="RazorSitemapBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(RazorSitemapBuildTasksExecutablePath)')"
               Text="Razor sitemap native BuildTasks executable not found at '$(RazorSitemapBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(RazorSitemapBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_RazorSitemapProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(RazorSitemapBuildTasksExecutablePath)&quot; --targetPath &quot;$(TargetPath)&quot; --projectDir &quot;$(_RazorSitemapProjectDir)&quot;$(_RazorSitemapBaseUrlArg)$(_RazorSitemapOutputPathArg)$(_RazorSitemapDefaultChangeFrequencyArg)$(_RazorSitemapDefaultPriorityArg)$(_RazorSitemapIncludeUnannotatedPagesArg)' />
    </Target>
</Project>
