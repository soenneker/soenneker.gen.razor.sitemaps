<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <_RazorSitemapAttributeSourceFromPackage>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Soenneker.Gen.Razor.Sitemaps.SitemapAttribute.g.cs'))</_RazorSitemapAttributeSourceFromPackage>
        <_RazorSitemapAttributeSourceFromProject>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'SitemapAttribute.cs'))</_RazorSitemapAttributeSourceFromProject>
        <_RazorSitemapAttributeSource Condition="'$(_RazorSitemapAttributeSource)'=='' and Exists('$(_RazorSitemapAttributeSourceFromPackage)')">$(_RazorSitemapAttributeSourceFromPackage)</_RazorSitemapAttributeSource>
        <_RazorSitemapAttributeSource Condition="'$(_RazorSitemapAttributeSource)'=='' and Exists('$(_RazorSitemapAttributeSourceFromProject)')">$(_RazorSitemapAttributeSourceFromProject)</_RazorSitemapAttributeSource>
    </PropertyGroup>

</Project>
