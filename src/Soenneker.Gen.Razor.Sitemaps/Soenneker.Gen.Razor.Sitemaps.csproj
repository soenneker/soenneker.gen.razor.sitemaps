<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Automatic sitemap generation for Razor apps at build time. Fast, deterministic, and zero-runtime overhead.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Gen.Razor.Sitemaps</AssemblyName>
        <PackageId>Soenneker.Gen.Razor.Sitemaps</PackageId>
        <PackageTags>gen razor sitemaps source generator generation sitemap razorsitemapgenerator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.gen.razor.sitemaps</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.gen.razor.sitemaps</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="SitemapAttribute.cs" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Gen.Razor.Sitemaps.props" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Gen.Razor.Sitemaps.props" Pack="true" PackagePath="buildTransitive\" />
        <None Include="Soenneker.Gen.Razor.Sitemaps.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Gen.Razor.Sitemaps.targets" Pack="true" PackagePath="buildTransitive\" />
        <None Include="SitemapAttribute.cs" Pack="true" PackagePath="build\Soenneker.Gen.Razor.Sitemaps.SitemapAttribute.g.cs" />
        <None Include="SitemapAttribute.cs" Pack="true" PackagePath="buildTransitive\Soenneker.Gen.Razor.Sitemaps.SitemapAttribute.g.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <SitemapNativeRuntimeIdentifier Condition="'$(SitemapNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</SitemapNativeRuntimeIdentifier>
        <SitemapNativeArtifactsDir Condition="'$(SitemapNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</SitemapNativeArtifactsDir>
        <_SitemapNativeExecutable>Soenneker.Gen.Razor.Sitemaps.BuildTasks</_SitemapNativeExecutable>
        <_SitemapNativeExecutable Condition="$([System.String]::Copy('$(SitemapNativeRuntimeIdentifier)').StartsWith('win-'))">$(_SitemapNativeExecutable).exe</_SitemapNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(SitemapUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(SitemapNativeSource);../Soenneker.Gen.Razor.Sitemaps.BuildTasks/obj/project.assets.json"
            Outputs="$(SitemapNativeArtifactsDir)/$(SitemapNativeRuntimeIdentifier)/$(_SitemapNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Gen.Razor.Sitemaps.BuildTasks/Soenneker.Gen.Razor.Sitemaps.BuildTasks.csproj&quot; --configuration Release --runtime $(SitemapNativeRuntimeIdentifier) --output &quot;$(SitemapNativeArtifactsDir)/$(SitemapNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <SitemapNativeSource Include="../Soenneker.Gen.Razor.Sitemaps.BuildTasks/**/*.cs;../Soenneker.Gen.Razor.Sitemaps.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Gen.Razor.Sitemaps.BuildTasks/bin/**;../Soenneker.Gen.Razor.Sitemaps.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_SitemapRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(SitemapUsePrebuiltNativeTools)' == 'true'" />
            <_SitemapNativeFile Include="$(SitemapNativeArtifactsDir)/**/*"
                                Exclude="$(SitemapNativeArtifactsDir)/**/*.pdb;$(SitemapNativeArtifactsDir)/**/*.dbg;$(SitemapNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_SitemapNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_SitemapRequiredRuntime)' != '' and !Exists('$(SitemapNativeArtifactsDir)/%(_SitemapRequiredRuntime.Identity)/Soenneker.Gen.Razor.Sitemaps.BuildTasks') and !Exists('$(SitemapNativeArtifactsDir)/%(_SitemapRequiredRuntime.Identity)/Soenneker.Gen.Razor.Sitemaps.BuildTasks.exe')"
               Text="Missing native sitemap tool for %(_SitemapRequiredRuntime.Identity)." />
        <Error Condition="'@(_SitemapNativeFile)' == ''" Text="Native sitemap tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
